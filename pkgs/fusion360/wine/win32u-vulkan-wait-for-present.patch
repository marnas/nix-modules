+/* only a guard against a present that never completes, the wait is expected to return long before */
+#define PRESENT_WAIT_TIMEOUT 1000000000ull
+
+static const VkPresentIdKHR *find_present_id( const VkPresentInfoKHR *present_info )
+{
+    const VkBaseInStructure *header;
+
+    for (header = present_info->pNext; header; header = header->pNext)
+        if (header->sType == VK_STRUCTURE_TYPE_PRESENT_ID_KHR) return (const VkPresentIdKHR *)header;
+
+    return NULL;
+}
+
+/* An offscreen surface is not shown to the user by the present, client_surface_present() blits it to
+ * the window afterwards. vkQueuePresentKHR only queues that present, so the blit reads the window
+ * before the frame has landed in it, copies the frame before this one, and the window keeps showing
+ * that one until something presents again. The OpenGL paths call glFinish() at the same point for
+ * the same reason. Surfaces that are not offscreen are presented to their window directly. */
+static BOOL needs_present_wait( struct vulkan_device *device, struct surface *surface )
+{
+    if (!device->extensions.has_VK_KHR_present_id || !device->extensions.has_VK_KHR_present_wait) return FALSE;
+    if (!device->p_vkWaitForPresentKHR) return FALSE;
+    return InterlockedCompareExchange( &surface->client->offscreen, 0, 0 ) != 0;
+}
+
 static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentInfoKHR *client_present_info )
 {
     VkPresentInfoKHR *present_info = (VkPresentInfoKHR *)client_present_info; /* cast away const, it has been copied in the thunks */
     struct vulkan_queue *queue = vulkan_queue_from_handle( client_queue );
     VkSwapchainKHR swapchains_buffer[16], *swapchains = swapchains_buffer;
+    uint64_t present_ids_buffer[16], *present_ids = present_ids_buffer;
     struct vulkan_device *device = queue->device;
     const VkSwapchainKHR *client_swapchains;
+    const uint64_t *wait_ids = NULL;
+    const VkPresentIdKHR *client_ids;
+    VkPresentIdKHR present_id_info;
     VkResult res;
 
     TRACE( "queue %p, present_info %p\n", queue, present_info );
@@ -1965,6 +2020,12 @@ static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentI
     if (present_info->swapchainCount > ARRAY_SIZE(swapchains_buffer) &&
         !(swapchains = malloc( present_info->swapchainCount * sizeof(*swapchains) )))
         return VK_ERROR_OUT_OF_HOST_MEMORY;
+    if (present_info->swapchainCount > ARRAY_SIZE(present_ids_buffer) &&
+        !(present_ids = malloc( present_info->swapchainCount * sizeof(*present_ids) )))
+    {
+        if (swapchains != swapchains_buffer) free( swapchains );
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    }
 
     for (uint32_t i = 0; i < present_info->waitSemaphoreCount; i++)
     {
@@ -1989,6 +2050,34 @@ static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentI
         client_surface_update( surface->client );
     }
 
+    if ((client_ids = find_present_id( present_info )))
+    {
+        /* the application numbers its own presents, wait on its ids instead of chaining a second struct */
+        if (client_ids->swapchainCount == present_info->swapchainCount) wait_ids = client_ids->pPresentIds;
+    }
+    else
+    {
+        uint32_t waiting = 0;
+
+        for (uint32_t i = 0; i < present_info->swapchainCount; i++)
+        {
+            struct swapchain *swapchain = swapchain_from_handle( client_swapchains[i] );
+
+            if (!needs_present_wait( device, swapchain->surface )) present_ids[i] = 0;
+            else present_ids[i] = ++swapchain->present_id, waiting++;
+        }
+
+        if (waiting)
+        {
+            present_id_info.sType = VK_STRUCTURE_TYPE_PRESENT_ID_KHR;
+            present_id_info.pNext = present_info->pNext;
+            present_id_info.swapchainCount = present_info->swapchainCount;
+            present_id_info.pPresentIds = present_ids;
+            present_info->pNext = &present_id_info;
+            wait_ids = present_ids;
+        }
+    }
+
     res = device->p_vkQueuePresentKHR( queue->host.queue, present_info );
 
     for (uint32_t i = 0; i < present_info->swapchainCount; i++)
@@ -1998,6 +2087,10 @@ static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentI
         struct surface *surface = swapchain->surface;
         RECT client_rect;
 
+        if (wait_ids && wait_ids[i] && swapchain_res >= VK_SUCCESS && needs_present_wait( device, surface ))
+            device->p_vkWaitForPresentKHR( device->host.device, swapchain->obj.host.swapchain,
+                                           wait_ids[i], PRESENT_WAIT_TIMEOUT );
+
         client_surface_present( surface->client );
 
         if (swapchain_res < VK_SUCCESS) continue;
@@ -2019,6 +2112,7 @@ static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentI
     }
 
