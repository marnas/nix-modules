+        // ALSA clients routed through PipeWire report themselves as
+        // "PipeWire ALSA [app]" with no binary and no icon name; unwrap the
+        // real app name so the row can show it and find its icon.
+        private static string app_name (PulseSinkInput sink_input) {
+            string name = sink_input.name ?? "";
+            const string PREFIX = "PipeWire ALSA [";
+            if (name.has_prefix (PREFIX) && name.has_suffix ("]")) {
+                name = name.substring (PREFIX.length,
+                                       name.length - PREFIX.length - 1);
+            }
+            return name;
         }
 
