dwrite: Key the cached glyph bitmap on the rendering mode.

dwrite_fontface_get_glyph_bitmap() builds its cache key from the font size and
the glyph index only, but the layout depends on the rendering mode: aliased is
1bpp with a pitch of ((width + 31) >> 5) << 2, the antialiased modes are 8bpp
with (width + 3) / 4 * 4. A glyph rasterized in one mode and then requested in
the other gets the wrong layout and the wrong is_1bpp flag.

Autodesk Fusion hits this in its tooltips: the ribbon rasterizes in GDI_CLASSIC,
the tooltips ask for the same glyphs in ALIASED, and every capital the ribbon had
already drawn comes out at full width and half height - Tahoma Bold at 11px, an
'O' as 8x4 pixels instead of 8x8.

Remember the mode with the cached bitmap and re-rasterize when it differs; the
two layouts differ in size, so the cache accounting is updated by the difference.

--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -60,6 +60,7 @@
     RECT bbox;
     BYTE *bitmap;
     unsigned int bitmap_size;
+    unsigned short bitmap_mode;
     unsigned int is_1bpp : 1;
     unsigned int has_contours : 1;
     unsigned int has_advance : 1;
@@ -225,7 +226,9 @@
     }
     else if ((entry = fontface_get_cache_entry(fontface, bitmap_size, &key)))
     {
-        if (entry->has_bitmap)
+        /* Aliased rendering produces a 1bpp bitmap with a different pitch than the
+         * antialiased modes, so a cached bitmap only fits the mode it was made for. */
+        if (entry->has_bitmap && entry->bitmap_mode == rendering_mode)
         {
             memcpy(bitmap->buf, entry->bitmap, entry->bitmap_size);
         }
@@ -234,10 +237,18 @@
             params.is_1bpp = &_1bpp;
             UNIX_CALL(get_glyph_bitmap, &params);
 
+            free(entry->bitmap);
+            fontface->cache.size += bitmap_size - entry->bitmap_size;
             entry->bitmap_size = bitmap_size;
             if ((entry->bitmap = malloc(entry->bitmap_size)))
                 memcpy(entry->bitmap, bitmap->buf, entry->bitmap_size);
+            else
+            {
+                fontface->cache.size -= entry->bitmap_size;
+                entry->bitmap_size = 0;
+            }
             entry->is_1bpp = !!_1bpp;
+            entry->bitmap_mode = rendering_mode;
             entry->has_bitmap = 1;
         }
         *is_1bpp = entry->is_1bpp;
